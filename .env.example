# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL datasource)
# Example local placeholder: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prospera_referral_db?schema=public"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security Configuration
# In production, OTP_SECRET MUST be an explicitly configured, random secret of at least 32 characters
OTP_SECRET="replace-with-cryptographically-secure-random-secret-min-32-chars"
SESSION_EXPIRY_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_TOUCH_INTERVAL_MINUTES=5
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Login Rate Limiting / Throttling (SEC-02)
LOGIN_ACCOUNT_MAX_FAILED_ATTEMPTS=5
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_FAILED_ATTEMPTS=20
LOGIN_IP_LOCKOUT_MINUTES=15
# In multi-instance / clustered production deployments, set to true to ensure startup fails safely
# until a shared distributed storage adapter (e.g. Redis) is deployed.
REQUIRE_SHARED_THROTTLER=false

