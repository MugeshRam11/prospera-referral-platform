// ============================================================================
// PROPOSED DATA MODEL - PHASE 2 DATABASE DESIGN
//
// NOTE: This schema is a proposed architectural design and has NOT been migrated
// to a live database. Migrations will be executed in a future phase.
// All financial values use fixed-precision Decimal(12, 2) and immutable ledgers.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  REFERRAL_PARTNER
  AGENT
  COORDINATOR
  ADMIN
}

enum AgentType {
  INDEPENDENT
  AGENCY_MEMBER
}

enum AgencyRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENT
}

enum AgencyStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
  BANK_CHANGE
}

enum KycDocumentType {
  EMIRATES_ID_FRONT
  EMIRATES_ID_BACK
  PASSPORT
  TRADE_LICENSE
  VAT_CERTIFICATE
  BANK_STATEMENT
  BANK_CONFIRMATION_LETTER
  BROKER_CARD_BRN
  ESTABLISHMENT_CARD
  POWER_OF_ATTORNEY
  OTHER
}

enum KycStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  CHANGES_REQUESTED
}

enum LeadStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  CANCELLED
}

enum CommissionEntryType {
  ACCRUAL
  ADJUSTMENT
  REVERSAL
  CANCELLATION
}

enum CommissionStatus {
  PENDING_CLEARANCE
  AVAILABLE
  LOCKED_DISPUTE
  CANCELLED
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER_UAE
  INTERNATIONAL_WIRE
  CHEQUE
  MANUAL
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  SENT
  FAILED
  DELIVERED
}

// ----------------------------------------------------------------------------
// 1. IDENTITY & ACCESS
// ----------------------------------------------------------------------------

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  fullName        String        @map("full_name") @db.VarChar(255)
  phone           String?       @db.VarChar(50)
  whatsapp        String?       @db.VarChar(50)
  avatarUrl       String?       @map("avatar_url") @db.VarChar(512)
  brn             String?       @db.VarChar(50)
  nationality     String?       @db.VarChar(100)
  role            Role          @default(REFERRAL_PARTNER)
  agentType       AgentType     @default(INDEPENDENT) @map("agent_type")
  accountStatus   AccountStatus @default(PENDING_VERIFICATION) @map("account_status")

  // Coordinator assignment hierarchy
  coordinatorId   String?       @map("coordinator_id") @db.Uuid
  coordinator     User?         @relation("CoordinatorAssignments", fields: [coordinatorId], references: [id])
  assignedUsers   User[]        @relation("CoordinatorAssignments")

  companyName          String?       @map("company_name") @db.VarChar(255)
  referralCode         String?       @unique @map("referral_code") @db.VarChar(50)
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz
  kycVerifiedAt        DateTime?     @map("kyc_verified_at") @db.Timestamptz
  deletionRequestedAt  DateTime?     @map("deletion_requested_at") @db.Timestamptz

  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz
  approvedById    String?       @map("approved_by_id") @db.Uuid
  approvedBy      User?         @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers   User[]        @relation("UserApprovals")

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Child relations
  sessions                 Session[]
  otpChallenges            OtpChallenge[]
  kycDocuments             KycDocument[]             @relation("UserKycDocuments")
  reviewedKycDocuments     KycDocument[]             @relation("KycReviewer")
  bankAccounts             BankAccount[]
  verifiedBankAccounts     BankAccount[]             @relation("BankAccountVerifier")
  partnerLeads             Lead[]                    @relation("PartnerLeads")
  agentLeads               Lead[]                    @relation("AgentLeads")
  coordinatorLeads         Lead[]                    @relation("CoordinatorLeads")
  leadStatusChanges        LeadStatusHistory[]
  commissionEntries        CommissionLedgerEntry[]   @relation("CommissionRecipient")
  createdCommissionEntries CommissionLedgerEntry[]   @relation("CommissionCreator")
  withdrawals              WithdrawalRequest[]       @relation("UserWithdrawals")
  approvedWithdrawals      WithdrawalRequest[]       @relation("WithdrawalApprover")
  processedPayouts         PayoutEvent[]
  auditLogs                AuditLog[]
  agencyMemberships        AgencyMember[]
  createdAgencies          Agency[]                  @relation("AgencyCreator")
  sentAgencyInvitations    AgencyInvitation[]        @relation("InvitationSender")
  verifiedAgencies         Agency[]                  @relation("AgencyVerifier")

  @@index([role, accountStatus])
  @@index([agentType])
  @@index([coordinatorId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String     @db.VarChar(255)
  codeHash      String     @map("code_hash") @db.VarChar(255)
  purpose       OtpPurpose
  attemptsCount Int        @default(0) @map("attempts_count")
  maxAttempts   Int        @default(5) @map("max_attempts")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz
  consumedAt    DateTime?  @map("consumed_at") @db.Timestamptz
  ipAddress     String?    @map("ip_address") @db.VarChar(45)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, purpose, consumedAt, expiresAt])
  @@map("otp_challenges")
}

// ----------------------------------------------------------------------------
// 2. AGENCY & ORGANIZATION MANAGEMENT
// ----------------------------------------------------------------------------

model Agency {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(255)
  legalName       String        @map("legal_name") @db.VarChar(255)
  tradeLicenseNo  String        @unique @map("trade_license_no") @db.VarChar(100)
  orn             String?       @db.VarChar(50)
  dedLicenseNo    String?       @map("ded_license_no") @db.VarChar(50)
  email           String        @db.VarChar(255)
  phone           String        @db.VarChar(50)
  address         String?       @db.Text
  poBox           String?       @map("po_box") @db.VarChar(50)
  status          AgencyStatus  @default(PENDING_VERIFICATION)
  rejectionReason String?       @map("rejection_reason") @db.Text

  createdById     String        @map("created_by_id") @db.Uuid
  createdBy       User          @relation("AgencyCreator", fields: [createdById], references: [id])
  verifiedById    String?       @map("verified_by_id") @db.Uuid
  verifiedBy      User?         @relation("AgencyVerifier", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  members         AgencyMember[]
  invitations     AgencyInvitation[]
  documents       KycDocument[]
  bankAccounts    BankAccount[]

  @@index([status])
  @@map("agencies")
}

model AgencyMember {
  id        String     @id @default(uuid()) @db.Uuid
  agencyId  String     @map("agency_id") @db.Uuid
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AgencyRole @default(AGENT)
  status    String     @default("ACTIVE") @db.VarChar(50)
  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([agencyId, userId])
  @@index([userId])
  @@index([agencyId])
  @@map("agency_members")
}

model AgencyInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  agencyId    String           @map("agency_id") @db.Uuid
  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email       String           @db.VarChar(255)
  role        AgencyRole       @default(AGENT)
  inviteToken String           @unique @map("invite_token") @db.VarChar(128)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz
  invitedById String           @map("invited_by_id") @db.Uuid
  invitedBy   User             @relation("InvitationSender", fields: [invitedById], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([agencyId, status])
  @@index([email])
  @@map("agency_invitations")
}

// ----------------------------------------------------------------------------
// 3. COMPLIANCE & BANKING
// ----------------------------------------------------------------------------

model KycDocument {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  user             User            @relation("UserKycDocuments", fields: [userId], references: [id], onDelete: Cascade)
  agencyId         String?         @map("agency_id") @db.Uuid
  agency           Agency?         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  documentType     KycDocumentType @map("document_type")
  fileKey          String          @map("file_key") @db.VarChar(512)
  originalFilename String          @map("original_filename") @db.VarChar(255)
  fileSizeBytes    Int             @map("file_size_bytes")
  mimeType         String          @map("mime_type") @db.VarChar(100)
  sha256Checksum   String          @map("sha256_checksum") @db.VarChar(64)
  status           KycStatus       @default(PENDING_REVIEW)
  rejectionReason  String?         @map("rejection_reason") @db.Text
  reviewedById     String?         @map("reviewed_by_id") @db.Uuid
  reviewedBy       User?           @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz
  expiryDate       DateTime?       @map("expiry_date") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, status])
  @@index([agencyId, status])
  @@map("kyc_documents")
}

model BankAccount {
  id                      String              @id @default(uuid()) @db.Uuid
  userId                  String              @map("user_id") @db.Uuid
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId                String?             @map("agency_id") @db.Uuid
  agency                  Agency?             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bankName                String              @map("bank_name") @db.VarChar(255)
  accountHolderName       String              @map("account_holder_name") @db.VarChar(255)
  ibanLast4               String              @map("iban_last4") @db.VarChar(4)
  encryptedIban           String              @map("encrypted_iban") @db.Text
  encryptedSwift          String?             @map("encrypted_swift") @db.Text
  currency                String              @default("AED") @db.VarChar(3)
  bankConfirmationDocKey  String?             @map("bank_confirmation_doc_key") @db.VarChar(512)
  isPrimary               Boolean             @default(true) @map("is_primary")
  isVerified              Boolean             @default(false) @map("is_verified")
  rejectionReason         String?             @map("rejection_reason") @db.Text
  verifiedById            String?             @map("verified_by_id") @db.Uuid
  verifiedBy              User?               @relation("BankAccountVerifier", fields: [verifiedById], references: [id])
  verifiedAt              DateTime?           @map("verified_at") @db.Timestamptz
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  withdrawals             WithdrawalRequest[]

  @@index([userId, isPrimary])
  @@index([agencyId])
  @@map("bank_accounts")
}

// ----------------------------------------------------------------------------
// 3. SERVICE CATALOG & COMMISSION RULES
// ----------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(255)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  services    Service[]

  @@map("service_categories")
}

model Service {
  id                          String           @id @default(uuid()) @db.Uuid
  categoryId                  String           @map("category_id") @db.Uuid
  category                    ServiceCategory  @relation(fields: [categoryId], references: [id])
  slug                        String           @unique @db.VarChar(100)
  name                        String           @db.VarChar(255)
  description                 String?          @db.Text
  defaultPartnerCommissionBps Int              @default(0) @map("default_partner_commission_bps")
  defaultAgentCommissionBps   Int              @default(0) @map("default_agent_commission_bps")
  isActive                    Boolean          @default(true) @map("is_active")
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  leads                       Lead[]
  commissionRules             CommissionRule[]

  @@map("services")
}

model CommissionRule {
  id                   String    @id @default(uuid()) @db.Uuid
  serviceId            String?   @map("service_id") @db.Uuid
  service              Service?  @relation(fields: [serviceId], references: [id])
  ruleName             String    @map("rule_name") @db.VarChar(255)
  minDealValue         Decimal   @default(0.00) @map("min_deal_value") @db.Decimal(12, 2)
  maxDealValue         Decimal?  @map("max_deal_value") @db.Decimal(12, 2)
  partnerCommissionBps Int       @map("partner_commission_bps")
  agentCommissionBps   Int       @map("agent_commission_bps")
  validFrom            DateTime  @map("valid_from") @db.Date
  validUntil           DateTime? @map("valid_until") @db.Date
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("commission_rules")
}

model LostReason {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")
  leads    Lead[]

  @@map("lost_reasons")
}

// ----------------------------------------------------------------------------
// 4. LEAD & REFERRAL PIPELINE
// ----------------------------------------------------------------------------

model Lead {
  id                         String     @id @default(uuid()) @db.Uuid
  referenceNo                String     @unique @map("reference_no") @db.VarChar(32)
  partnerId                  String     @map("partner_id") @db.Uuid
  partner                    User       @relation("PartnerLeads", fields: [partnerId], references: [id])
  coordinatorId              String?    @map("coordinator_id") @db.Uuid
  coordinator                User?      @relation("CoordinatorLeads", fields: [coordinatorId], references: [id])
  agentId                    String?    @map("agent_id") @db.Uuid
  agent                      User?      @relation("AgentLeads", fields: [agentId], references: [id])
  serviceId                  String     @map("service_id") @db.Uuid
  service                    Service    @relation(fields: [serviceId], references: [id])

  clientName                 String     @map("client_name") @db.VarChar(255)
  clientEmail                String?    @map("client_email") @db.VarChar(255)
  clientPhone                String     @map("client_phone") @db.VarChar(50)
  expectedDealValue          Decimal    @map("expected_deal_value") @db.Decimal(12, 2)
  actualDealValue            Decimal?   @map("actual_deal_value") @db.Decimal(12, 2)
  currency                   String     @default("AED") @db.VarChar(3)

  customPartnerCommissionBps Int?       @map("custom_partner_commission_bps")
  customAgentCommissionBps   Int?       @map("custom_agent_commission_bps")

  status                     LeadStatus @default(SUBMITTED)
  wonAt                      DateTime?  @map("won_at") @db.Timestamptz

  lostReasonId               String?    @map("lost_reason_id") @db.Uuid
  lostReason                 LostReason? @relation(fields: [lostReasonId], references: [id])
  lostDetails                String?    @map("lost_details") @db.Text
  notes                      String?    @db.Text

  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  statusHistory              LeadStatusHistory[]
  commissionEntries          CommissionLedgerEntry[]

  @@index([partnerId, status])
  @@index([agentId, status])
  @@index([coordinatorId, status])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

model LeadStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedById    String   @map("changed_by_id") @db.Uuid
  changedBy      User     @relation(fields: [changedById], references: [id])
  previousStatus String?  @map("previous_status") @db.VarChar(50)
  newStatus      String   @map("new_status") @db.VarChar(50)
  transitionNote String?  @map("transition_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

// ----------------------------------------------------------------------------
// 5. FINANCIAL LEDGER & COMMISSIONS
// ----------------------------------------------------------------------------

model CommissionLedgerEntry {
  id              String              @id @default(uuid()) @db.Uuid
  idempotencyKey  String              @unique @map("idempotency_key") @db.VarChar(128)
  leadId          String              @map("lead_id") @db.Uuid
  lead            Lead                @relation(fields: [leadId], references: [id])
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  recipientUser   User                @relation("CommissionRecipient", fields: [recipientUserId], references: [id])
  recipientRole   Role                @map("recipient_role")
  entryType       CommissionEntryType @map("entry_type")
  status          CommissionStatus    @default(AVAILABLE)

  dealValue       Decimal             @map("deal_value") @db.Decimal(12, 2)
  commissionBps   Int                 @map("commission_bps")
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("AED") @db.VarChar(3)
  description     String              @db.Text

  createdById     String?             @map("created_by_id") @db.Uuid
  createdBy       User?               @relation("CommissionCreator", fields: [createdById], references: [id])
  availableAt     DateTime            @default(now()) @map("available_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@unique([leadId, recipientUserId, entryType])
  @@index([recipientUserId, status])
  @@index([createdAt(sort: Desc)])
  @@map("commission_ledger_entries")
}

// ----------------------------------------------------------------------------
// 6. WITHDRAWALS & PAYOUTS
// ----------------------------------------------------------------------------

model WithdrawalRequest {
  id              String           @id @default(uuid()) @db.Uuid
  referenceNo     String           @unique @map("reference_no") @db.VarChar(32)
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation("UserWithdrawals", fields: [userId], references: [id])
  bankAccountId   String           @map("bank_account_id") @db.Uuid
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id])
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("AED") @db.VarChar(3)
  status          WithdrawalStatus @default(REQUESTED)

  userNotes       String?          @map("user_notes") @db.Text
  adminNotes      String?          @map("admin_notes") @db.Text
  rejectionReason String?          @map("rejection_reason") @db.Text

  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedBy      User?            @relation("WithdrawalApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz
  paidAt          DateTime?        @map("paid_at") @db.Timestamptz

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  payoutEvents    PayoutEvent[]

  @@index([userId, status])
  @@map("withdrawal_requests")
}

model PayoutEvent {
  id                   String            @id @default(uuid()) @db.Uuid
  withdrawalRequestId  String            @map("withdrawal_request_id") @db.Uuid
  withdrawalRequest    WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id])
  processedById        String            @map("processed_by_id") @db.Uuid
  processedBy          User              @relation(fields: [processedById], references: [id])

  payoutMethod         PayoutMethod      @map("payout_method")
  transactionReference String            @map("transaction_reference") @db.VarChar(255)
  disbursedAmount      Decimal           @map("disbursed_amount") @db.Decimal(12, 2)
  feeDeducted          Decimal           @default(0.00) @map("fee_deducted") @db.Decimal(12, 2)
  currency             String            @default("AED") @db.VarChar(3)
  executedAt           DateTime          @map("executed_at") @db.Timestamptz
  receiptFileKey       String?           @map("receipt_file_key") @db.VarChar(512)

  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([withdrawalRequestId])
  @@index([transactionReference])
  @@map("payout_events")
}

// ----------------------------------------------------------------------------
// 7. AUDIT & LOGGING
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(64)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model NotificationLog {
  id             String              @id @default(uuid()) @db.Uuid
  recipientEmail String              @map("recipient_email") @db.VarChar(255)
  templateName   String              @map("template_name") @db.VarChar(100)
  subject        String              @db.VarChar(255)
  channel        NotificationChannel @default(EMAIL)
  status         NotificationStatus
  errorMessage   String?             @map("error_message") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientEmail, createdAt(sort: Desc)])
  @@map("notification_logs")
}

// ----------------------------------------------------------------------------
// 8. CMS & MARKETING CONTENT
// ----------------------------------------------------------------------------

model CmsBanner {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(255)
  subtitle     String?  @db.Text
  ctaText      String?  @map("cta_text") @db.VarChar(100)
  ctaLink      String?  @map("cta_link") @db.VarChar(255)
  imageUrl     String   @map("image_url") @db.VarChar(512)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("cms_banners")
}

model CmsFaq {
  id           String   @id @default(uuid()) @db.Uuid
  category     String   @default("General") @db.VarChar(100)
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("cms_faqs")
}

model CmsPost {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(255)
  title         String    @db.VarChar(255)
  summary       String?   @db.Text
  contentHtml   String    @map("content_html") @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.VarChar(512)
  authorName    String    @map("author_name") @db.VarChar(255)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  isPublished   Boolean   @default(false) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("cms_posts")
}

model CmsTeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  designation  String   @db.VarChar(255)
  bio          String?  @db.Text
  photoUrl     String?  @map("photo_url") @db.VarChar(512)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("cms_team_members")
}
